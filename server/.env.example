# FTADS Server Environment Configuration

# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ftads_dev
DB_SSL=false

# Test Database (used when NODE_ENV=test)
TEST_DB_NAME=ftads_test

# Security & CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Anomaly Detection Settings
ALGORITHM_VERSION=1.0.0
ANOMALY_ALERT_THRESHOLD=60.0

# Demo Safeguards
DEMO_MODE=true
ALLOW_DEMO_RESEED=true
