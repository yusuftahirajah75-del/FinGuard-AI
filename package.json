{
  "name": "ftads-root",
  "version": "1.0.0",
  "description": "Financial Transaction Anomaly Detection System (FTADS)",
  "private": true,
  "scripts": {
    "start": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "server:test": "npm --prefix server test",
    "client:test": "npm --prefix client test",
    "test": "npm --prefix server test && npm --prefix client test",
    "migrate": "npm --prefix server run migrate",
    "seed": "npm --prefix server run seed",
    "reset-demo": "npm --prefix server run reset-demo",
    "build": "npm --prefix client run build"
  }
}
